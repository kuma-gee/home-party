{
    "name": "home-party-controller",
    "description": "Smartphone controller UI for Home Party VR game. Connects to Godot via WebRTC.",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "build": "rm ../build/web -r && vite build --config vite/config.prod.mjs && cp build ../build/web -r",
        "preview": "vite preview --outDir build"
    },
    "devDependencies": {
        "@tsconfig/svelte": "^5.0.4",
        "@sveltejs/adapter-auto": "6.0.0",
        "@sveltejs/adapter-static": "3.0.8",
        "@sveltejs/kit": "2.20.7",
        "@sveltejs/vite-plugin-svelte": "5.0.3",
        "svelte": "5.23.1",
        "svelte-check": "^4.0.2",
        "terser": "5.39.0",
        "tslib": "2.7.0",
        "typescript": "5.7.2",
        "vite": "6.3.1"
    },
    "type": "module",
    "dependencies": {}
}