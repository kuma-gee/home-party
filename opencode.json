{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "crush",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "enabled": true,
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      }
    }
  }
}
