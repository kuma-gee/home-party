{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": { "disable": true},
    "plan": { "disable": true}
  },
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "enabled": false,
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      }
    },
    "godot-debug": {
      "type": "local",
      "command": [
        "bash",
        ".opencode/mcp/run-godot-debug.sh"
      ],
      "enabled": true
    }
  }
}
