[sub_resource type="Shader" id="Shader_ve3ly"]
code = "shader_type canvas_item;

// Samples neighboring pixels to detect edges and draws an outline around opaque areas.

uniform vec4 outline_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float outline_width : hint_range(0.0, 10.0, 0.5) = 1.0;

void fragment() {
	vec4 center = texture(TEXTURE, UV);

	// Sample 8 neighbors to check if any are transparent (edge detection)
	vec2 offset = outline_width * TEXTURE_PIXEL_SIZE;
	float alpha = 0.0;
	alpha += texture(TEXTURE, UV + vec2(-offset.x, 0.0)).a;
	alpha += texture(TEXTURE, UV + vec2( offset.x, 0.0)).a;
	alpha += texture(TEXTURE, UV + vec2(0.0, -offset.y)).a;
	alpha += texture(TEXTURE, UV + vec2(0.0,  offset.y)).a;
	alpha += texture(TEXTURE, UV + vec2(-offset.x, -offset.y)).a;
	alpha += texture(TEXTURE, UV + vec2( offset.x, -offset.y)).a;
	alpha += texture(TEXTURE, UV + vec2(-offset.x,  offset.y)).a;
	alpha += texture(TEXTURE, UV + vec2( offset.x,  offset.y)).a;

	// Draw outline where neighbors are opaque but center is transparent
	float is_outline = clamp(alpha, 0.0, 1.0) * (1.0 - center.a);
	COLOR = mix(center, outline_color, is_outline);
}
"

