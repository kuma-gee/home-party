[resource]
script = ExtResource("1_script")
name = "Hide and Seek"
description = "A prop hunt game where the VR player is 'It' (the seeker) and mobile players hide as objects in a themed room. The VR player physically rummages through the space — grabbing, shaking, and inspecting props to find the hiders."
scene = ExtResource("2_scene")
icon = ExtResource("3_icon")
min_recommended_players = 3
max_recommended_players = 8
